{
  "name": "@alkemio/ingest-alkemio-data",
  "version": "0.20.0",
  "description": "",
  "author": "Alkemio Foundation",
  "private": true,
  "license": "EUPL-1.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prebuild": "npm run clean",
    "clean": "rimraf ./dist",
    "format": "biome format --write src/ graphql/",
    "codegen": "graphql-codegen -v --config codegen.yml",
    "lint": "tsc --noEmit && biome check src/",
    "lint:fix": "tsc --noEmit && biome check --write src/",
    "prepublishOnly": "npm run build",
    "start:dev": "dotenvx run -f .env.development -- nodemon",
    "start": "node --trace-deprecation ./dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@dotenvx/dotenvx": "^0.35.1",
    "@graphql-codegen/add": "^3.2.1",
    "@graphql-codegen/cli": "2.11.8",
    "@graphql-codegen/typescript": "2.7.3",
    "@graphql-codegen/typescript-graphql-request": "^4.5.3",
    "@graphql-codegen/typescript-operations": "^2.5.3",
    "@graphql-codegen/typescript-resolvers": "2.7.3",
    "@types/amqplib": "^0.10.5",
    "@types/graphql-upload": "^8.0.11",
    "@types/node": "^14.14.10",
    "@types/semver": "^7.3.4",
    "@types/supertest": "^2.0.8",
    "@types/url-join": "^4.0.1",
    "@vitest/coverage-v8": "^3.1.1",
    "nodemon": "^3.1.0",
    "rimraf": "^3.0.2",
    "supertest": "^4.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@alkemio/client-lib": "^0.35.0",
    "@chroma-core/openai": "^0.1.10",
    "@langchain/community": "^1.1.3",
    "@langchain/core": "^1.1.12",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/mistralai": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "amqplib": "^0.10.4",
    "chromadb": "^3.3.3",
    "dotenv": "^16.0.1",
    "file-type": "^19.0.0",
    "graphql": "^16.6.0",
    "graphql-request": "5.1.0",
    "graphql-upload": "^16.0.1",
    "langchain": "^1.2.7",
    "langsmith": "^0.2.0",
    "mammoth": "^1.7.2",
    "node-html-parser": "^7.0.1",
    "officeparser": "^4.1.1",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "winston": "^3.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=16.15.0",
    "npm": ">=8.5.5"
  },
  "volta": {
    "node": "22.20.0"
  }
}
