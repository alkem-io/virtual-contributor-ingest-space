EMBEDDINGS_MODEL_NAME=qwen3-embedding-8b

VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=8765
VECTOR_DB_CREDENTIALS=root:toor

CHUNK_SIZE=2000
CHUNK_OVERLAP=200

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
